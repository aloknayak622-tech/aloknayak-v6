# Copy these into Vercel > Project > Settings > Environment Variables. Never commit real values.
TOKEN_SECRET=              # any random 40+ characters (signs access tokens)
RAZORPAY_KEY_ID=           # rzp_test_... first, rzp_live_... only after testing
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=   # the secret you type when creating the webhook in Razorpay
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REVIEWERS=                 # Name:key,Name2:key2 (each key 20+ random characters). These people can review questions.
GEMINI_API_KEY=            # only needed for generating new questions
GEMINI_MODEL=              # the Gemini model id you want to use
AI_DAILY_CALLS=200         # hard daily cap on AI calls (cost control)
